# Local defaults. Copy these keys to your private .env and fill in provider/mail values.
APP_ENV=development
# Leave blank for a persistent local secret file. In production, set a unique random value (32+ bytes).
AUTH_SECRET=
PLACEMENTGAP_AUTH_DB=./data/auth.sqlite3
PLACEMENTGAP_AUTH_SECRET_FILE=./data/auth.secret

# Use the same hostname in your browser and OAuth registration. Current local Chrome URL uses 127.0.0.1.
FRONTEND_URL=http://127.0.0.1:5174
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5174

# Email OTP for signup, passwordless sign-in, and password recovery.
# SMTP port 587 uses STARTTLS. Set SMTP_USE_SSL=true for implicit TLS, usually port 465.
# Leave SMTP_HOST blank for local development; OTP codes are displayed in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth app: add this exact URI as an authorized redirect URI.
# http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app: use the same 127.0.0.1 host in browser, callback, and frontend
# so the session cookie remains available. Add this redirect URI as a Web URI. Entra's
# portal may require adding HTTP loopback URIs through the app manifest instead.
# http://127.0.0.1:8000/auth/microsoft/callback
MICROSOFT_FRONTEND_URL=http://127.0.0.1:5173
MICROSOFT_REDIRECT_BASE=http://127.0.0.1:8000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# GitHub OAuth app: set this as the Authorization callback URL.
# http://127.0.0.1:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
